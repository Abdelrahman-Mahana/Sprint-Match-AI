# ---------------------------------------------------------------------------------------------
# SprintMatch AI configuration. Copy to `.env` and adjust. NEVER commit `.env`.
# ---------------------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true

# PostgreSQL (docker-compose exposes the db service on localhost:5432)
DATABASE_URL=postgresql+psycopg://sprintmatch:change-me-locally@localhost:5432/sprintmatch
# Used only by the integration test-suite (a separate, disposable database):
TEST_DATABASE_URL=postgresql+psycopg://sprintmatch:change-me-locally@localhost:5432/sprintmatch_test
# Used by docker-compose for the database container:
POSTGRES_USER=sprintmatch
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=sprintmatch

# ---------------------------------------------------------------------------------------------
# LLM provider (optional). The deterministic recommendation engine works with LLM_PROVIDER=none.
#   none | mock | openai_compatible | ollama
# ---------------------------------------------------------------------------------------------
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
# json_schema (strict structured output) | json_object (for providers without json_schema support)
LLM_STRUCTURED_OUTPUT_MODE=json_schema
# Upper bound (s) for a provider-requested Retry-After on HTTP 429 (rate limits)
LLM_MAX_RETRY_WAIT_SECONDS=20
# deterministic | llm  (llm explanations are grounding-checked, with deterministic fallback)
EXPLANATION_MODE=deterministic

# ---------------------------------------------------------------------------------------------
# LangGraph agent (workforce research agent with read-only tools)
# AGENT_TOOL_MODE: auto (native tool calling if the model supports it, else JSON tool plan, else disabled)
#                  | native | json_plan | disabled
# ---------------------------------------------------------------------------------------------
AGENT_TOOL_MODE=auto
AGENT_MAX_TOOL_ROUNDS=5
AGENT_MAX_TOOL_CALLS=20
AGENT_TOOL_TIMEOUT_SECONDS=10
AGENT_MAX_TOOL_RESULT_ITEMS=25
AGENT_MAX_TOOL_RESULT_CHARS=12000
AGENT_MAX_PROFILE_EXPANSIONS=10
AGENT_NODE_MAX_ATTEMPTS=2
AGENT_RETRY_INITIAL_INTERVAL_SECONDS=0.5

# LangGraph checkpoints (graph execution state, separate from recommendation history)
# postgres | memory | none
CHECKPOINTER=postgres
CHECKPOINT_SCHEMA=agent_checkpoints
CHECKPOINT_RETENTION_DAYS=30

# Example: OpenAI-compatible cloud/self-hosted provider (vLLM, LM Studio, OpenRouter, ...)
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=your_secret_api_key
# LLM_MODEL=your-model-name

# Example: local Ollama
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=your-local-model

# ---------------------------------------------------------------------------------------------
# API authentication. Only SHA-256 digests of API keys are configured.
# Generate:  uv run python scripts/hash_api_key.py "<your-key>"
# The digests below belong to the DEVELOPMENT-ONLY keys "dev-manager-key" and "dev-viewer-key".
# ---------------------------------------------------------------------------------------------
API_KEYS=[{"name":"dev-manager","role":"manager","company_code":"NDS","key_sha256":"a7ed54c1352fc514d529204456f59403b94b106fd46e6a039f515a89891d939b"},{"name":"dev-viewer","role":"viewer","company_code":"NDS","key_sha256":"d07bb46a73e9d6b0d4482c098a58db8243bdfa876acf21e7b50e41547f991bcb"}]
RATE_LIMIT_PER_MINUTE=30

# ---------------------------------------------------------------------------------------------
# Recommendation defaults
# ---------------------------------------------------------------------------------------------
DEFAULT_HORIZON_WORKING_DAYS=5
ACCEPT_LLM_EFFORT_ESTIMATES=false

# Demo data: reference date (YYYY-MM-DD). Empty = today. Seed controls reproducibility.
DEMO_REFERENCE_DATE=
DEMO_SEED=20261103

# ==============================================================================
# SprintMatch AI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
#
# Environments:
#   - development: Default local setup with SQLite or local PostgreSQL
#   - test: Used by pytest test runner (isolated test DB, in-memory checkpointer)
#   - production: Strict security, required API keys, JSON logging, PostgreSQL checkpointer
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & LOGGING
# ------------------------------------------------------------------------------
APP_NAME="SprintMatch AI"
# Options: development | test | production
ENVIRONMENT=development
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Emit structured JSON logs (true) or plain human-readable text (false)
LOG_JSON=false

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Primary application database connection string (SQLAlchemy format)
# For local PostgreSQL (default dev cluster):
DATABASE_URL=postgresql+psycopg://sprintmatch:sprintmatch@localhost:5432/sprintmatch
# For local SQLite (lightweight alternative):
# DATABASE_URL=sqlite:///./sprintmatch.db
# Dedicated test database (used by pytest integration suite)
TEST_DATABASE_URL=postgresql+psycopg://sprintmatch:sprintmatch@localhost:55432/sprintmatch_test

# Database pool and connection settings
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# PostgreSQL container credentials (used by docker-compose)
POSTGRES_USER=sprintmatch
POSTGRES_PASSWORD=sprintmatch
POSTGRES_DB=sprintmatch

# ------------------------------------------------------------------------------
# 3. SCHEMA ADAPTATION (Zero-Code Foreign Database Integration)
# ------------------------------------------------------------------------------
# Adapter mode:
#   - auto: Use native schema if present, otherwise auto-discover foreign tables
#   - native: Enforce native schema structure
#   - adaptive: Always run via schema-discovery and adaptive mapping
DATABASE_ADAPTER=auto
SCHEMA_MAPPING_PATH=schema_mapping.json

# Fallback values when external databases lack timezone or shift definitions
ADAPTIVE_DEFAULT_TIMEZONE=UTC
ADAPTIVE_ASSUME_DEFAULT_SCHEDULE=true
ADAPTIVE_DEFAULT_DAILY_HOURS=8.0

# Optional separate internal database for agent runs, checkpoints, and audit trails
# when connecting read-only to external client/enterprise databases:
# INTERNAL_DATABASE_URL=postgresql+psycopg://...

# ------------------------------------------------------------------------------
# 4. LLM PROVIDER CONFIGURATION (Optional - Deterministic Core Runs Without LLM)
# ------------------------------------------------------------------------------
# Options: none | mock | openai_compatible | ollama
# Note: When set to 'none', all recommendations and explanations run on the
# high-performance deterministic rule-based engine.
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=45.0
LLM_MAX_RETRIES=2
LLM_MAX_RETRY_WAIT_SECONDS=20.0
# Options: json_schema | json_object
LLM_STRUCTURED_OUTPUT_MODE=json_schema
# Explanation generation mode: deterministic | llm
EXPLANATION_MODE=deterministic

# ------------------------------------------------------------------------------
# 5. LANGGRAPH AGENT & TOOL EXECUTION
# ------------------------------------------------------------------------------
# Tool execution mode: auto | native | json_plan | disabled
AGENT_TOOL_MODE=auto
AGENT_MAX_TOOL_ROUNDS=5
AGENT_MAX_TOOL_CALLS=20
AGENT_TOOL_TIMEOUT_SECONDS=10.0
AGENT_MAX_TOOL_RESULT_ITEMS=25
AGENT_MAX_TOOL_RESULT_CHARS=12000
AGENT_MAX_PROFILE_EXPANSIONS=10
AGENT_NODE_MAX_ATTEMPTS=2
AGENT_RETRY_INITIAL_INTERVAL_SECONDS=0.5

# ------------------------------------------------------------------------------
# 6. LANGGRAPH CHECKPOINTING (Persistent Agent State)
# ------------------------------------------------------------------------------
# Options: postgres | memory | none
CHECKPOINTER=postgres
CHECKPOINT_SCHEMA=agent_checkpoints
CHECKPOINT_RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# 7. SECURITY & RATE LIMITING
# ------------------------------------------------------------------------------
# JSON array of authorized API keys with SHA-256 hashes and roles.
# Leave empty in development to permit dev keys ('dev-manager-key', 'dev-admin-key')
API_KEYS=[]
RATE_LIMIT_PER_MINUTE=30

# ------------------------------------------------------------------------------
# 8. RECOMMENDATION ENGINE DEFAULTS
# ------------------------------------------------------------------------------
DEFAULT_HORIZON_WORKING_DAYS=5
ACCEPT_LLM_EFFORT_ESTIMATES=false

# ------------------------------------------------------------------------------
# 9. DEMO SEEDING & BENCHMARKS
# ------------------------------------------------------------------------------
DEMO_REFERENCE_DATE=2026-11-03
DEMO_SEED=20261103
